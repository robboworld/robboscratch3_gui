<!DOCTYPE html>
<html<% if (htmlWebpackPlugin.options.seo && htmlWebpackPlugin.options.seo.enabled) { %> lang="ru"<% } %>>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="google" value="notranslate">
    <title><%= htmlWebpackPlugin.options.title %></title>
    <% if (htmlWebpackPlugin.options.seo && htmlWebpackPlugin.options.seo.enabled) { %>
    <% var seo = htmlWebpackPlugin.options.seo; %>
    <meta name="description" content="<%= seo.description %>">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="<%= seo.canonical %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= seo.siteName %>">
    <meta property="og:title" content="<%= htmlWebpackPlugin.options.title %>">
    <meta property="og:description" content="<%= seo.description %>">
    <meta property="og:url" content="<%= seo.canonical %>">
    <meta property="og:image" content="<%= seo.ogImage %>">
    <meta property="og:locale" content="<%= seo.locale %>">
    <meta name="twitter:card" content="summary">
    <meta name="twitter:title" content="<%= htmlWebpackPlugin.options.title %>">
    <meta name="twitter:description" content="<%= seo.description %>">
    <meta name="twitter:image" content="<%= seo.ogImage %>">
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "name": "<%= seo.siteName %>",
          "url": "<%= seo.siteUrl %>/",
          "inLanguage": "ru",
          "description": "<%= seo.description %>"
        },
        {
          "@type": "WebApplication",
          "name": "<%= seo.siteName %>",
          "url": "<%= seo.siteUrl %>/",
          "applicationCategory": "EducationalApplication",
          "operatingSystem": "Web",
          "inLanguage": "ru",
          "description": "<%= seo.description %>",
          "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "RUB"
          }
        },
        {
          "@type": "Organization",
          "name": "<%= seo.organizationName %>",
          "url": "<%= seo.organizationUrl %>"
        }
      ]
    }
    </script>
    <% } %>
    <% if (htmlWebpackPlugin.options.sentryConfig) { %>
        <!-- Sentry error logging to help with finding bugs -->
        <script src="https://cdn.ravenjs.com/3.22.1/raven.min.js" crossorigin="anonymous"></script>
        <script>
            Raven.config(<%= htmlWebpackPlugin.options.sentryConfig %>).install();
        </script>
        <!-- /Sentry -->
    <% } %>
    <% if (htmlWebpackPlugin.options.yandexMetrika) { %>
    <!-- Yandex.Metrika counter -->
    <script type="text/javascript">
       (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
       m[i].l=1*new Date();
       for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
       k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
       (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
       ym(<%= htmlWebpackPlugin.options.yandexMetrika %>, "init", {clickmap:true, trackLinks:true, accurateTrackBounce:true, webvisor:true});
    </script>
    <noscript><div><img src="https://mc.yandex.ru/watch/<%= htmlWebpackPlugin.options.yandexMetrika %>" style="position:absolute; left:-9999px;" alt="" /></div></noscript>
    <!-- /Yandex.Metrika counter -->
    <% } %>
  </head>
  <body>
    <% if (htmlWebpackPlugin.options.loadingSplash) { %>
    <% var splash = htmlWebpackPlugin.options.loadingSplash; %>
    <!-- Static copy of components/loader: visible from the first paint while lib.min.js and
         gui.js download and run; removed by lib/loading-splash.js when the React Loader mounts. -->
    <style>
      #app-loading-splash {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: 5000;
        display: flex; justify-content: center; align-items: center;
        background-color: #00af41; color: #383838; text-align: center;
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      }
      #app-loading-splash .splash-blocks { width: 125px; height: 150px; margin: 50px auto 0; }
      #app-loading-splash .splash-blocks img { display: block; position: relative; height: 30%; margin-top: -4px; }
      #app-loading-splash .splash-top { animation: app-splash-top 1.5s ease infinite; }
      #app-loading-splash .splash-middle { animation: app-splash-middle 1.5s ease infinite; }
      #app-loading-splash .splash-bottom { animation: app-splash-bottom 1.5s ease infinite; }
      /* The message line stays empty: the React Loader picks a random one. */
      #app-loading-splash .splash-title { font-size: 2rem; font-weight: bold; margin: 0.75rem 0; }
      #app-loading-splash .splash-message { height: 30px; }
      @keyframes app-splash-top {
        0% { transform: translateY(50px); opacity: 0; }
        33% { transform: translateY(0); opacity: 1; }
      }
      @keyframes app-splash-middle {
        0%, 33% { transform: translateY(50px); opacity: 0; }
        66% { transform: translateY(0); opacity: 1; }
      }
      @keyframes app-splash-bottom {
        0%, 66% { transform: translateY(50px); opacity: 0; }
        100% { transform: translateY(0); opacity: 1; }
      }
    </style>
    <noscript><style>#app-loading-splash { display: none; }</style></noscript>
    <div id="app-loading-splash" aria-busy="true">
      <div>
        <div class="splash-blocks">
          <img class="splash-top" src="<%= splash.top %>" alt="">
          <img class="splash-middle" src="<%= splash.middle %>" alt="">
          <img class="splash-bottom" src="<%= splash.bottom %>" alt="">
        </div>
        <div class="splash-title" id="app-loading-splash-title">&nbsp;</div>
        <div class="splash-message"></div>
      </div>
    </div>
    <script>
      // The editor locale as lib/detect-locale.js resolves it (URL, saved choice, browser),
      // to show the Loader title right away.
      (function () {
        var titles = <%= splash.headlinesJson %>;
        var has = function (locale) { return Object.prototype.hasOwnProperty.call(titles, locale); };
        var locale = null;
        try {
          var params = new URLSearchParams(window.location.search);
          var fromUrl = (params.get('locale') || params.get('lang') || '').toLowerCase();
          if (fromUrl && has(fromUrl)) locale = fromUrl;
        } catch (e) {}
        if (!locale) {
          try {
            var saved = JSON.parse(window.localStorage.getItem('scratch-gui-layout-visibility-v1') || 'null');
            if (saved && typeof saved.locale === 'string' && has(saved.locale)) locale = saved.locale;
          } catch (e) {}
        }
        if (!locale) {
          var browser = String(navigator.userLanguage || navigator.language || '').toLowerCase();
          locale = has(browser) ? browser : (has(browser.split('-')[0]) ? browser.split('-')[0] : 'en');
        }
        var title = document.getElementById('app-loading-splash-title');
        if (title && titles[locale]) title.textContent = titles[locale];
      })();
    </script>
    <% } %>
    <% if (htmlWebpackPlugin.options.seo && htmlWebpackPlugin.options.seo.enabled) { %>
    <% var seoBody = htmlWebpackPlugin.options.seo; %>
    <noscript>
      <h1><%= seoBody.siteName %></h1>
      <p><%= seoBody.description %></p>
      <p>Визуальное программирование для детей и школ: создавайте игры и анимации, подключайте роботов РОББО и управляйте ими прямо из браузера.</p>
      <p>Для работы редактора включите JavaScript в браузере.</p>
    </noscript>
    <% } %>
  </body>
</html>
